#!/bin/sh
set -eu

zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
unsigned=""

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$zero" ]; then
        continue
    fi
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi
    found=$(git log --format='%G? %h %s' $range | grep -E '^[NB] ' || true)
    if [ -n "$found" ]; then
        unsigned="$unsigned$found
"
    fi
done

if [ -n "$unsigned" ]; then
    echo "pre-push: these commits are unsigned or badly signed; sign them before pushing:" >&2
    printf '%s' "$unsigned" | sed 's/^/  /' >&2
    exit 1
fi
